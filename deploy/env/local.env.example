# Disposable local development only; never use these credentials in production.
# Copy to the repository root: cp deploy/env/local.env.example .env.local
MONGO_INITDB_ROOT_USERNAME=local_root
MONGO_INITDB_ROOT_PASSWORD=local_root_password
MONGO_APP_USERNAME=local_app
MONGO_APP_PASSWORD=local_app_password
MONGO_DB_NAME=url_shortener
REDIS_PASSWORD=local_redis_password
LOCAL_HTTP_PORT=8080
# Choose a matching subnet/IP pair if running multiple local projects at once.
LOCAL_PROXY_SUBNET=172.30.80.0/29
LOCAL_PROXY_IP=172.30.80.2
LOCAL_APP_PROXY_IP=172.30.80.3

# Per-client limits; creation and redirects have separate allowances.
CREATE_RATE_PER_SECOND=2
CREATE_RATE_BURST=4
REDIRECT_RATE_PER_SECOND=10
REDIRECT_RATE_BURST=20
# deploy/compose.local.yml sets PUBLIC_BASE_URL from LOCAL_HTTP_PORT and trusts only Caddy.
