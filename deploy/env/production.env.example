# Copy to the repository root: cp deploy/env/production.env.example .env
# Set actual deployment values before use.
# MongoDB environment variables
MONGO_INITDB_ROOT_USERNAME=your-username-here
MONGO_INITDB_ROOT_PASSWORD=your-password-here

# Application user
MONGO_APP_USERNAME=your-username-here
MONGO_APP_PASSWORD=your-password-here

# MongoDB Database Name
MONGO_DB_NAME=url_shortener

# Redis
REDIS_PASSWORD=your-redis-password

# Caddy
DOMAIN_NAME=your-app-domain
EMAIL=your-email-for-tls

# Placeholder only: previous domain/hosting expired. Set a new origin before deployment.
# Never derived from request headers.
PUBLIC_BASE_URL=https://short.example
# Dedicated app/Caddy network; Compose trusts only the proxy's exact IP.
PROXY_SUBNET=172.30.81.0/29
PROXY_IP=172.30.81.2
APP_PROXY_IP=172.30.81.3

CREATE_RATE_PER_SECOND=2
CREATE_RATE_BURST=4
REDIRECT_RATE_PER_SECOND=10
REDIRECT_RATE_BURST=20
